{
  "ignoreFiles": [
    "openclaw/**",
    "apps/**",
    "scripts/**",
    "src/ot/**",
    "src/ot/**/*",
    "e2e/**",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.e2e.ts",
    "**/*.stories.tsx",
    "**/*.d.ts",
    "server/test-utils/**",
    "server/test-utils/**/*",
    "src/mocks/**",
    "src/mocks/**/*",
    "server/engine/executeSingleTool.ts",
    "@types/**"
  ],
  "workspaces": {
    ".": {
      "paths": {
        "@/": ["src/*"],
        "@src/*": ["src/*"],
        "@cdf-know/*": ["packages/*/src"]
      },
      "entry": [
        "index.html!",
        "server/routes/*.ts!",
        "src/pages/**/*.tsx!",
        "src/pages/**/*.ts!",
        "cli/index.ts!",
        "cli/src/index.ts!",
        "electron/main.ts!",
        "electron/preload.ts!",
        "electron/exec-approval-server.ts!"
      ],
      "project": [
        "src/**/*.{ts,tsx}!",
        "server/**/*.ts!",
        "cli/**/*.ts!",
        "electron/**/*.ts!",
        "shared/**/*.ts!",
        "*.config.{ts,mjs,cjs,js}!"
      ],
      "ignoreExportsUsedInFile": true
    },
    "packages/*": {
      "project": ["src/**/*.ts!"],
      "ignoreExportsUsedInFile": true
    }
  }
}
