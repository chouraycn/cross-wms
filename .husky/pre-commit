#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# P0-⑪: pre-commit hook — lint staged files + fast typecheck
# Intercepts 80% of CI failures locally before they reach remote

# 1. Lint only staged files (fast)
npx lint-staged

# 2. Incremental type check (uses tsbuildinfo cache)
npx tsc --noEmit --incremental 2>&1 | tail -5
