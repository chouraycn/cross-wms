{
  "id": "openrouter",
  "name": "OpenRouter Provider",
  "description": "OpenRouter multi-model aggregator LLM provider extension",
  "version": "1.0.0",
  "kind": "provider",
  "sdkVersion": "1.0.0",
  "requiresAuth": true,
  "authType": "api-key",
  "providers": ["openrouter"],
  "modelSupport": {
    "modelPrefixes": ["openrouter/", "anthropic/", "openai/", "google/", "meta-llama/", "mistralai/", "cohere/"]
  },
  "providerEndpoints": [
    {
      "endpointClass": "openrouter-native",
      "hosts": ["openrouter.ai"]
    }
  ],
  "setup": {
    "providers": [
      {
        "id": "openrouter",
        "envVars": ["OPENROUTER_API_KEY"]
      }
    ]
  }
}
