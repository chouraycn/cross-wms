{
  "id": "mistral",
  "name": "Mistral Provider",
  "description": "Mistral AI LLM provider extension with Chat Completions API support",
  "version": "1.0.0",
  "kind": "provider",
  "sdkVersion": "1.0.0",
  "requiresAuth": true,
  "authType": "api-key",
  "providers": ["mistral"],
  "modelSupport": {
    "modelPrefixes": ["mistral-", "pixtral-", "codestral", "ministral-"]
  },
  "providerEndpoints": [
    {
      "endpointClass": "mistral-native",
      "hosts": ["api.mistral.ai"]
    }
  ],
  "setup": {
    "providers": [
      {
        "id": "mistral",
        "envVars": ["MISTRAL_API_KEY"]
      }
    ]
  }
}
