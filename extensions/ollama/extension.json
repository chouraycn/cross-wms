{
  "id": "ollama",
  "name": "Ollama Provider",
  "description": "Ollama local LLM provider extension (no API key required)",
  "version": "1.0.0",
  "kind": "provider",
  "sdkVersion": "1.0.0",
  "requiresAuth": false,
  "authType": "none",
  "providers": ["ollama"],
  "modelSupport": {
    "modelPrefixes": ["llama", "mistral", "gemma", "qwen", "deepseek", "phi", "llava"]
  },
  "providerEndpoints": [
    {
      "endpointClass": "ollama-local",
      "hosts": ["localhost:11434", "127.0.0.1:11434"]
    }
  ],
  "setup": {
    "providers": [
      {
        "id": "ollama",
        "envVars": ["OLLAMA_BASE_URL"]
      }
    ]
  }
}
